{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(css|js|games)/(.+)\\.(css|js|json|png|jpg|jpeg|svg|ico|mp3|wav|ogg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
